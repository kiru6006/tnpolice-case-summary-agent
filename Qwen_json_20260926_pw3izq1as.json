{
  "title": "CaseHealthScore",
  "type": "object",
  "required": ["case_id", "overall_score", "category_scores", "flags", "generated_at"],
  "properties": {
    "case_id": {"type": "string"},
    "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
    "category_scores": {
      "type": "object",
      "properties": {
        "document_completeness": {"type": "number"},
        "procedural_compliance": {"type": "number"},
        "evidentiary_consistency": {"type": "number"},
        "timeline_coherence": {"type": "number"}
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "description", "citations"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "major", "minor", "info"]},
          "category": {"type": "string"},
          "description": {"type": "string"},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "document_type": {"type": "string"},
                "page_number": {"type": "integer"},
                "bounding_box": {"type": "array", "items": {"type": "number"}}
              }
            }
          },
          "legal_reference": {"type": "string"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "agent_version": {"type": "string"}
  }
}