# Environment Configuration
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=postgresql+asyncpg://vetri_user:vetri_secret_password@localhost:5432/vetri_cases_db

# Storage (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads

# AWS S3 (Used when STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=vetri-case-bundles-ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LLM Providers (Pick one or use local Ollama)
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=vetri-case-summary-agent
